# Copy to .env.local. Use a NEW Firebase project, never the mobile project.
EXPO_PUBLIC_EXHIBITION_FIREBASE_API_KEY=YOUR_API_KEY
EXPO_PUBLIC_EXHIBITION_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_EXHIBITION_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_EXHIBITION_FIREBASE_APP_ID=YOUR_APP_ID
EXPO_PUBLIC_EXHIBITION_FIREBASE_DATABASE_URL=https://YOUR_DATABASE.asia-southeast1.firebasedatabase.app
# Optional: defaults to OpenStreetMap tiles; keep provider attribution.
# EXPO_PUBLIC_WEB_MAP_TILE_URL=https://your-tile-provider/{z}/{x}/{y}.png
# Required for real hardware on a public HTTPS site. No ws:// mixed content.
EXPO_PUBLIC_EXHIBITION_HAZARD_WS_URL=
