          ]}
          onPress={() =>
            setUserType(userType === 'user' ? 'guardian' : 'user')
          }
        >
          <Text style={{ color: 'white', fontSize: 20 }}>
            현재: {userType === 'user' ? '사용자' : '보호자'}
