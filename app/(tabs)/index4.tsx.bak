                }}
                onPress={() => {
                  handleVoice(`${target.name}의 위치 화면으로 이동합니다`);
                  requireLogin('pathLog');
                }}
              >
                <View
                  style={{
                    width: 46,
                    height: 46,
                    borderRadius: 23,
                    backgroundColor: '#2A2A2A',
                    justifyContent: 'center',
                    alignItems: 'center',
                    marginRight: 12,
                  }}
                >
                  <Ionicons name="person" size={24} color={BRAND_COLOR} />
                </View>
                <View style={{ flex: 1 }}>
                  <Text style={{ color: 'white', fontSize: 17, fontWeight: '900' }}>
                    {target.name}
                  </Text>
                  <Text style={{ color: '#aaa', fontSize: 12, marginTop: 4 }}>
                    {target.lastSeen || '아직 위치 확인 전'}
                  </Text>
                </View>
                <View style={{ flexDirection: 'row', alignItems: 'center', marginRight: 10 }}>
                  <View style={{ width: 8, height: 8, borderRadius: 4, backgroundColor: BRAND_COLOR, marginRight: 6 }} />
                  <Text style={{ color: BRAND_COLOR, fontSize: 12, fontWeight: '900' }}>
                    {target.status || '안전'}
                  </Text>
                </View>
                <TouchableOpacity
                  onPress={() => {
                    setGuardianTargets(prev => prev.filter(item => item.id !== target.id));
                    Speech.stop();
                    Speech.speak('관리 대상에서 삭제되었습니다', { language: 'ko-KR' });
                  }}
                  style={{
                    width: 34,
                    height: 34,
                    borderRadius: 17,
                    backgroundColor: '#252525',
                    justifyContent: 'center',
                    alignItems: 'center',
                  }}
                >
                  <Ionicons name="trash-outline" size={18} color="#FF6B6B" />
                </TouchableOpacity>
              </TouchableOpacity>
            ))
          )}

          <TouchableOpacity
            onPress={addGuardianTarget}
            style={{
              backgroundColor: '#1A1A1A',
              borderRadius: 16,
              paddingVertical: 16,
              paddingHorizontal: 14,
              flexDirection: 'row',
              alignItems: 'center',
              justifyContent: 'center',
              borderWidth: 1,
              borderColor: '#333',
            }}
          >
            <Ionicons name="add" size={24} color="white" />
            <Text style={{ color: 'white', fontSize: 16, fontWeight: '900', marginLeft: 8 }}>
              새로운 대상 추가
            </Text>
          </TouchableOpacity>
        </View>

        <View style={{ flexDirection: 'row', gap: 12, marginBottom: 12 }}>
          <TouchableOpacity
            style={{
              flex: 1,
              height: 118,
              borderRadius: 18,
              backgroundColor: '#151515',
              justifyContent: 'center',
              alignItems: 'center',
              borderWidth: 1,
              borderColor: '#252525',
            }}
            onPress={() => requireLogin('pathLog')}
          >
            <Ionicons name="location" size={34} color={BRAND_COLOR} />
            <Text style={{ color: 'white', fontSize: 17, fontWeight: '900', marginTop: 10 }}>
              실시간 위치
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            disabled={!emergencyStatus}
            style={{
              flex: 1,
              height: 118,
              borderRadius: 18,
              backgroundColor: emergencyStatus ? '#351111' : '#151515',
              justifyContent: 'center',
              alignItems: 'center',
              borderWidth: 1,
              borderColor: emergencyStatus ? '#FF3B30' : '#252525',
            }}
            onPress={() => {
              Alert.alert(
                '긴급 위험 알림',
                '사용자가 긴급 도움을 요청했습니다. 현재 위치 화면으로 이동합니다.'
              );
              requireLogin('pathLog');
            }}
          >
            <Ionicons
              name={emergencyStatus ? 'notifications' : 'notifications-outline'}
              size={34}
              color={emergencyStatus ? '#FF6B6B' : '#777'}
            />
            <Text style={{ color: 'white', fontSize: 17, fontWeight: '900', marginTop: 10 }}>
              위험 알림
            </Text>
            <Text style={{ color: emergencyStatus ? '#FFB4B4' : '#888', fontSize: 12, marginTop: 5 }}>
              {emergencyStatus ? '긴급 요청 수신' : '새 알림 없음'}
            </Text>
          </TouchableOpacity>
        </View>

        <View style={{ flexDirection: 'row', gap: 12, marginBottom: 12 }}>
          <TouchableOpacity
            style={{
              flex: 1,
              height: 118,
              borderRadius: 18,
              backgroundColor: '#151515',
              justifyContent: 'center',
              alignItems: 'center',
              borderWidth: 1,
              borderColor: '#252525',
            }}
            onPress={() => requireLogin('pathLog')}
          >
            <Ionicons name="folder" size={34} color={BRAND_COLOR} />
            <Text style={{ color: 'white', fontSize: 17, fontWeight: '900', marginTop: 10 }}>
              이동 기록
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={{
              flex: 1,
              height: 118,
              borderRadius: 18,
              backgroundColor: '#151515',
              justifyContent: 'center',
              alignItems: 'center',
              borderWidth: 1,
              borderColor: '#252525',
            }}
            onPress={() => requireLogin('videoList')}
          >
            <Ionicons name="videocam" size={34} color={BRAND_COLOR} />
            <Text style={{ color: 'white', fontSize: 17, fontWeight: '900', marginTop: 10 }}>
              영상 기록
            </Text>
          </TouchableOpacity>
        </View>

        <TouchableOpacity
          style={{
            backgroundColor: '#151515',
            borderRadius: 18,
            paddingVertical: 20,
            paddingHorizontal: 18,
            flexDirection: 'row',
            alignItems: 'center',
            marginBottom: 10,
          }}
          onPress={() => Alert.alert('알림 설정', '낙상, 충돌, 배터리 부족 알림 설정 화면은 준비 중입니다.')}
        >
          <Ionicons name="notifications-outline" size={28} color={BRAND_COLOR} />
          <Text style={{ color: 'white', fontSize: 18, fontWeight: '900', marginLeft: 14, flex: 1 }}>
            알림 설정
          </Text>
          <Ionicons name="chevron-forward" size={22} color="#777" />
        </TouchableOpacity>

        <TouchableOpacity
          style={{
            backgroundColor: '#151515',
            borderRadius: 18,
            paddingVertical: 20,
            paddingHorizontal: 18,
            flexDirection: 'row',
            alignItems: 'center',
            marginBottom: 10,
          }}
          onPress={() => Alert.alert('설정', '계정, 관리 대상, 권한 설정 화면은 준비 중입니다.')}
        >
          <Ionicons name="settings" size={28} color={BRAND_COLOR} />
          <Text style={{ color: 'white', fontSize: 18, fontWeight: '900', marginLeft: 14, flex: 1 }}>
            설정
          </Text>
          <Ionicons name="chevron-forward" size={22} color="#777" />
        </TouchableOpacity>

        {currentUser && (
          <TouchableOpacity
            style={{
              backgroundColor: '#151515',
              borderRadius: 18,
              paddingVertical: 20,
              paddingHorizontal: 18,
              flexDirection: 'row',
              alignItems: 'center',
              borderWidth: 1,
              borderColor: '#3A1A1A',
            }}
            onPress={handleLogout}
          >
            <Ionicons name="log-out-outline" size={28} color="#FF6B6B" />
            <Text style={{ color: '#FF6B6B', fontSize: 18, fontWeight: '900', marginLeft: 14 }}>
              로그아웃
            </Text>
          </TouchableOpacity>
        )}
      </ScrollView>
    </View>
  ) : (
    <View style={styles.container}>
      {!isUser && emergencyStatus && (
        <TouchableOpacity
          style={styles.emergencyBanner}
          onPress={async () => {
            setEmergencyStatus(false);
            await set(ref(db, 'users/user01/status'), {
              emergency: false,
              timestamp: new Date().toISOString(),
            });
          }}
        >
          <Text style={styles.emergencyBannerText}>사용자 긴급 도움 요청 발생!</Text>
        </TouchableOpacity>
      )}

      <View style={styles.header}>
        <TouchableOpacity onPress={() => setCurrentScreen('route')}>
          <Ionicons name="chevron-back" size={32} color={themeColor} />
        </TouchableOpacity>
        <Text style={styles.headerTitle}>더보기</Text>
        <TouchableOpacity onPress={currentUser ? handleLogout : () => setCurrentScreen('login')}>
          <Ionicons name={currentUser ? 'log-out-outline' : 'person-circle'} size={30} color="white" />
        </TouchableOpacity>
      </View>

      <ScrollView contentContainerStyle={{ paddingHorizontal: 20, paddingBottom: 28 }}>
        <View style={{ flexDirection: 'row', gap: 12, marginTop: 12, marginBottom: 12 }}>
          <TouchableOpacity
            style={{
              flex: 1,
              height: 116,
              borderRadius: 18,
              backgroundColor: '#151515',
              justifyContent: 'center',
              alignItems: 'center',
            }}
            onPress={() => {
              if (!currentUser) {
                requireLogin('videoList');
                return;
              }

              handleVoice('영상 기록 화면으로 이동합니다');
              setCurrentScreen('videoList');
            }}
          >
            <Ionicons name="videocam" size={32} color={themeColor} />
            <Text style={{ color: 'white', fontSize: 18, fontWeight: '800', marginTop: 12 }}>
              영상 기록
            </Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={{
              flex: 1,
              height: 116,
              borderRadius: 18,
              backgroundColor: '#151515',
              justifyContent: 'center',
              alignItems: 'center',
            }}
            onPress={async () => {
              if (!isUser) {
                setCurrentScreen('pathLog');
                return;
              }

              if (isUpdatingShare) return;

              try {
                setIsUpdatingShare(true);
                const newValue = !shareLocation;
                await set(ref(db, 'users/user01/shareLocation'), newValue);
                setShareLocation(newValue);

                if (newValue && myLocation?.coords) {
                  const latitude = myLocation.coords.latitude;
                  const longitude = myLocation.coords.longitude;

                  await set(ref(db, `users/${currentUser?.uid}/location`), {
  latitude,
  longitude,
  timestamp: new Date().toISOString(),
});

                  lastLoggedLocationRef.current = { latitude, longitude };
                }
              } finally {
                setTimeout(() => setIsUpdatingShare(false), 300);
              }
            }}
          >
            <Ionicons name={shareLocation ? 'people' : 'people-outline'} size={32} color={themeColor} />
            <Text style={{ color: 'white', fontSize: 18, fontWeight: '800', marginTop: 12 }}>
              위치 공유
            </Text>
          </TouchableOpacity>
        </View>

        <TouchableOpacity
          style={{
            backgroundColor: '#B32626',
            borderRadius: 18,
            minHeight: 94,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'center',
            marginBottom: 12,
          }}
          onPress={
            isUser
              ? async () => {
                  setEmergencyStatus(true);
                  await set(ref(db, 'users/user01/status'), {
                    emergency: true,
                    timestamp: new Date().toISOString(),
                  });
                }
              : undefined
          }
        >
          <Ionicons name="alert-circle" size={34} color="white" />
          <Text style={{ color: 'white', fontSize: 22, fontWeight: '900', marginLeft: 12 }}>
            {isUser ? '긴급 도움 요청' : '긴급 상황 모니터링 중'}
          </Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={{
            backgroundColor: '#151515',
            borderRadius: 18,
            paddingVertical: 22,
            paddingHorizontal: 20,
            flexDirection: 'row',
            alignItems: 'center',
            marginBottom: 10,
          }}
          onPress={() => requireLogin('pathLog')}
        >
          <Ionicons name="list" size={28} color="#aaa" />
          <Text style={{ color: 'white', fontSize: 19, fontWeight: '800', marginLeft: 16 }}>
            기록 보기
          </Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={{
            backgroundColor: '#151515',
            borderRadius: 18,
            paddingVertical: 22,
            paddingHorizontal: 20,
            flexDirection: 'row',
            alignItems: 'center',
            marginBottom: 18,
          }}
          onPress={() => {
            Speech.stop();
            Speech.speak('설정 화면은 준비 중입니다', { language: 'ko-KR' });
          }}
        >
          <Ionicons name="settings" size={28} color="#aaa" />
          <Text style={{ color: 'white', fontSize: 19, fontWeight: '800', marginLeft: 16 }}>
            설정
          </Text>
        </TouchableOpacity>

        {currentUser && (
          <TouchableOpacity
            style={{
              backgroundColor: '#151515',
              borderRadius: 18,
              paddingVertical: 22,
              paddingHorizontal: 20,
              flexDirection: 'row',
              alignItems: 'center',
              marginBottom: 18,
              borderWidth: 1,
              borderColor: '#333',
            }}
            onPress={handleLogout}
          >
            <Ionicons name="log-out-outline" size={28} color="#FF6B6B" />
            <Text style={{ color: '#FF6B6B', fontSize: 19, fontWeight: '900', marginLeft: 16 }}>
              로그아웃
            </Text>
          </TouchableOpacity>
        )}

        {isUser && (
          <View
            style={{
              borderWidth: 1,
              borderColor: shareLocation ? '#D2FF00' : '#333',
              backgroundColor: shareLocation ? '#202600' : '#111',
              borderRadius: 18,
              padding: 18,
              flexDirection: 'row',
              alignItems: 'center',
            }}
          >
            <Ionicons
              name={shareLocation ? 'lock-open' : 'lock-closed'}
              size={30}
              color={shareLocation ? '#D2FF00' : '#aaa'}
            />
            <View style={{ marginLeft: 14, flex: 1 }}>
              <Text style={{ color: 'white', fontSize: 17, fontWeight: '900' }}>
                {shareLocation ? '보호자 위치 공유 중' : '위치 공유가 꺼져 있습니다'}
              </Text>
              <Text style={{ color: '#aaa', fontSize: 13, marginTop: 5 }}>
                위치 공유 버튼을 누르면 보호자가 현재 위치를 확인할 수 있습니다.
              </Text>
            </View>
          </View>
        )}
      </ScrollView>
    </View>
  );
  const [isHazard, setIsHazard] = useState(false);
  const [warningMessage, setWarningMessage] = useState<string | null>(null);

  // ------------------------------------------------------------
  // 8. 위험 알림 테스트 로직
  // ------------------------------------------------------------
  useEffect(() => {
    let warningTimer: ReturnType<typeof setTimeout> | null = null;
    let autoCloseTimer: ReturnType<typeof setTimeout> | null = null;

    if (currentScreen === 'cameraView') {
      warningTimer = setTimeout(async () => {
        const message = '차량이 접근 중입니다. 멈춰주세요.';

        setWarningMessage(message);
        setIsHazard(true);
        Vibration.vibrate([0, 500, 200, 500]);
         // 🔥 아이폰 알림센터 푸시알림
    await Notifications.scheduleNotificationAsync({
      content: {
        title: '위험 알림',
        body: message,
        sound: true,
      },
      trigger: null,
    });

    Speech.speak(message, {
      language: 'ko-KR',
      pitch: 1.0,
      rate: 1.0,
    });

  }, 3000);
}

    return () => {
      if (warningTimer) clearTimeout(warningTimer);
      if (autoCloseTimer) clearTimeout(autoCloseTimer);
    };
  }, [currentScreen]);

  // ------------------------------------------------------------
  // 9. 화면 라우팅
  // ------------------------------------------------------------
  return (
    <>
      <StatusBar barStyle="light-content" />
      {isHazard && warningMessage && (
        <TouchableOpacity
          style={styles.hazardOverlay}
          onPress={() => setIsHazard(false)}
        >
          <Ionicons name="warning" size={30} color="black" />
          <Text style={styles.hazardText}>{warningMessage.replace('\n', ' ')}</Text>
        </TouchableOpacity>
      )}
      {currentScreen === 'login' && LoginView()}
      {currentScreen === 'profileSetup' && (
  <View style={styles.container}>
    <View style={styles.header}>
      <Text style={styles.headerTitle}>추가 정보 입력</Text>
    </View>

    <View style={{ flex: 1, paddingHorizontal: 24, paddingTop: 40 }}>
      <Text
        style={{
          color: 'white',
          fontSize: 28,
          fontWeight: '900',
          textAlign: 'center',
          marginBottom: 30,
        }}
      >
        처음 로그인하셨네요
      </Text>

      <TextInput
        placeholder="이름 입력"
        placeholderTextColor="#777"
        style={styles.inputWrapper}
        onChangeText={(text) => {
          nameRef.current = text;
        }}
      />

      <TouchableOpacity
        style={[styles.loginButton, { backgroundColor: '#D2FF00' }]}
        onPress={async () => {
          if (!auth.currentUser) return;

if (!currentUser) return;

await update(ref(db, `users/${currentUser.uid}`), {            name: nameRef.current,
          });

          setCurrentScreen('home');
        }}
      >
        <Text style={styles.loginButtonText}>완료</Text>
      </TouchableOpacity>
    </View>
  </View>
)}
      {currentScreen === 'home' && <HomeView favorites={favorites} />}
      {currentScreen === 'pathLog' && (currentUser ? <PathLogView /> : LoginView())}
      {currentScreen === 'route' && (
        <RouteView
          routeCoords={routeCoords}
          myLocation={myLocation}
          themeColor={themeColor}
          heading={heading}
          userAddress={userAddress}
          destination={destination}
          setDestination={setDestination}
          setCurrentScreen={setCurrentScreen}
          getRoute={getRoute}
          searchPlace={searchPlace}
          setRouteCoords={setRouteCoords}
          setGuidePoints={setGuidePoints}
          setCurrentGuideIndex={setCurrentGuideIndex}
          guidePoints={guidePoints}
          currentGuideIndex={currentGuideIndex}
          searchResults={searchResults}
          setSearchResults={setSearchResults}
          searchPage={searchPage}
          setSearchPage={setSearchPage}
          hasMoreResults={hasMoreResults}
          setHasMoreResults={setHasMoreResults}
          recentPlaces={recentPlaces}
          setRecentPlaces={setRecentPlaces}
          favorites={favorites}
          setFavorites={setFavorites}
          mapRef={mapRef}
          isListening={isListening}
          startVoiceRecognition={startVoiceRecognition}

        />
      )}
      {currentScreen === 'cameraView' && (
        <View style={styles.container}>
          <View style={styles.header}>
            <TouchableOpacity onPress={() => setCurrentScreen('home')}>
              <Ionicons name="chevron-back" size={32} color={themeColor} />
            </TouchableOpacity>
            <Text style={styles.headerTitle}>현재 위치</Text>
            <View style={{ width: 32 }} />
          </View>

          <View style={{ flex: 1, paddingHorizontal: 24, paddingTop: 30 }}>
            <View
              style={{
                backgroundColor: '#111',
                borderRadius: 28,
                padding: 24,
                alignItems: 'center',
                marginBottom: 20,
              }}
            >
              <Ionicons name="camera" size={60} color={BRAND_COLOR} />

              <Text
                style={{
                  color: 'white',
                  fontSize: 24,
                  fontWeight: '800',
                  marginTop: 16,
                  textAlign: 'center',
                }}
              >
                카메라 연결 준비 중
              </Text>

              <Text
                style={{
                  color: '#aaa',
                  fontSize: 16,
                  marginTop: 10,
                  textAlign: 'center',
                  lineHeight: 24,
                }}
              >
                Raspberry Pi 카메라와 YOLO 객체 인식 모델을 연동해 보행 중 주변 장애물을 안내할 예정입니다.
              </Text>
            </View>

            <View
              style={{
                backgroundColor: '#111',
                borderRadius: 24,
                padding: 20,
                marginBottom: 14,
              }}
            >
              <Text style={{ color: BRAND_COLOR, fontSize: 18, fontWeight: '800', marginBottom: 12 }}>
                인식 예정 객체
              </Text>

              <Text style={{ color: 'white', fontSize: 17, marginBottom: 8 }}>• 사람</Text>
              <Text style={{ color: 'white', fontSize: 17, marginBottom: 8 }}>• 차량</Text>
              <Text style={{ color: 'white', fontSize: 17, marginBottom: 8 }}>• 장애물</Text>
              <Text style={{ color: 'white', fontSize: 17 }}>• 횡단보도 주변 위험 요소</Text>
            </View>

            <View
              style={{
                backgroundColor: '#1A1A1A',
                borderRadius: 24,
                padding: 20,
              }}
            >
              <Text style={{ color: 'white', fontSize: 18, fontWeight: '800', marginBottom: 10 }}>
                현재 구현 상태
              </Text>

              <Text style={{ color: '#aaa', fontSize: 16, lineHeight: 24 }}>
                현재는 GPS 기반 길찾기, 보호자 위치 공유, SOS 기능을 먼저 구현했으며,
                카메라 부품 수령 후 YOLO 인식 결과를 이 화면에 연결할 예정입니다.
              </Text>
            </View>
          </View>
        </View>
      )}
      {currentScreen === 'videoList' && currentUser && (
        <View style={styles.container}>
          <View style={styles.header}>
            <TouchableOpacity onPress={() => setCurrentScreen('home')}>
              <Ionicons name="chevron-back" size={32} color={themeColor} />
            </TouchableOpacity>
            <Text style={styles.headerTitle}>영상 기록</Text>
            <View style={{ width: 32 }} />
          </View>

          <View style={{ flex: 1, paddingHorizontal: 24, paddingTop: 30 }}>
            <View
              style={{
                backgroundColor: '#111',
                borderRadius: 28,
                padding: 24,
                marginBottom: 18,
              }}
            >
              <Ionicons name="videocam" size={54} color={BRAND_COLOR} />

              <Text style={{ color: 'white', fontSize: 24, fontWeight: '800', marginTop: 16 }}>
                인식 영상 기록 준비 중
              </Text>

              <Text style={{ color: '#aaa', fontSize: 16, lineHeight: 24, marginTop: 10 }}>
                YOLO 객체 인식 결과와 위험 감지 상황을 저장해 보호자 또는 사용자가 나중에 확인할 수 있도록 구성할 예정입니다.
              </Text>
            </View>

            <View style={{ backgroundColor: '#1A1A1A', borderRadius: 24, padding: 20 }}>
              <Text style={{ color: BRAND_COLOR, fontSize: 18, fontWeight: '800', marginBottom: 12 }}>
                저장 예정 정보
              </Text>

              <Text style={{ color: 'white', fontSize: 17, marginBottom: 8 }}>• 감지 시간</Text>
              <Text style={{ color: 'white', fontSize: 17, marginBottom: 8 }}>• 감지 객체</Text>
              <Text style={{ color: 'white', fontSize: 17, marginBottom: 8 }}>• 위험 상황 여부</Text>
              <Text style={{ color: 'white', fontSize: 17 }}>• 보호자 확인용 기록</Text>
            </View>
          </View>
        </View>
      )}
    </>
  );
}
