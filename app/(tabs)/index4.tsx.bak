        <View style={styles.logSection}>
          <Text style={[styles.logTitle, { color: themeColor }]}>{isUser ? "실시간 이동 로그" : "보호 데이터 모니터링"}</Text>
          <ScrollView>
            {moveLogs.map((log, i) => (
              <View key={i} style={styles.logItem}>
