            </Text>
          </View>
        </View>
      );
    }

    if (!displayCoords) {
      return <Text style={{ color: 'white', textAlign: 'center' }}>위치 정보 없음</Text>;
    }
    if (needsProfileSetup && currentUser) {
  return (
    <View style={styles.container}>
