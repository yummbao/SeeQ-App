          ) : (
            guardianTargets.map((target, index) => (
              <TouchableOpacity
                key={target.id}
                style={{
                  backgroundColor: '#1A1A1A',
                  borderRadius: 16,
                  padding: 14,
                  marginBottom: index === guardianTargets.length - 1 ? 12 : 10,
