// ============================================================
// 2. 길찾기 화면 Props
// ============================================================
type RouteViewProps = {
  routeCoords: any[];
  myLocation: any;
  themeColor: string;
  heading: number;
  userAddress: string;
  destination: string;
  setDestination: (text: string) => void;
  setCurrentScreen: (screen: string) => void;
  getRoute: (
    startLat: number,
    startLon: number,
    endLat: number,
    endLon: number
  ) => Promise<any>;
  searchPlace: (keyword: string, page?: number) => Promise<any>;
  setRouteCoords: React.Dispatch<React.SetStateAction<any[]>>;
  setGuidePoints: React.Dispatch<React.SetStateAction<any[]>>;
  setCurrentGuideIndex: React.Dispatch<React.SetStateAction<number>>;
  guidePoints: any[];
  currentGuideIndex: number;
  searchResults: any[];
  setSearchResults: React.Dispatch<React.SetStateAction<any[]>>;
  searchPage: number;
  setSearchPage: React.Dispatch<React.SetStateAction<number>>;
  hasMoreResults: boolean;
  setHasMoreResults: React.Dispatch<React.SetStateAction<boolean>>;
  recentPlaces: any[];
  setRecentPlaces: React.Dispatch<React.SetStateAction<any[]>>;
  favorites: any[];
  setFavorites: React.Dispatch<React.SetStateAction<any[]>>;
  mapRef: React.RefObject<MapView | null>;
  isListening: boolean;
  startVoiceRecognition: () => void;
};


// ============================================================
// 3. 길찾기 화면: 검색 / 즐겨찾기 / 경로 지도 / 최근 기록
// ============================================================
function RouteView({
  routeCoords,
  myLocation,
  themeColor,
  heading,
  userAddress,
  destination,
  setDestination,
  setCurrentScreen,
  getRoute,
  searchPlace,
  setRouteCoords,
  setGuidePoints,
  setCurrentGuideIndex,
  guidePoints,
  currentGuideIndex,
  searchResults,
  setSearchResults,
  searchPage,
  setSearchPage,
  hasMoreResults,
  setHasMoreResults,
  recentPlaces,
  setRecentPlaces,
  favorites,
  setFavorites,
  mapRef,
  isListening,
  startVoiceRecognition,
}: RouteViewProps) {
  const displayCoords = myLocation?.coords;
  const [isSearchMode, setIsSearchMode] = useState(false);
  const [isRouteMapMode, setIsRouteMapMode] = useState(false);
  const [isRecentHistoryMode, setIsRecentHistoryMode] = useState(false);
  const [isRecognitionOn, setIsRecognitionOn] = useState(true);

  const formatDistance = (distance: number) => {
    if (distance < 1000) return `${Math.round(distance)}미터`;
    return `${(distance / 1000).toFixed(1)}킬로미터`;
  };
  useEffect(() => {
    if (!myLocation?.coords || !mapRef.current) return;

    mapRef.current.animateToRegion(
      {
        latitude: myLocation.coords.latitude,
        longitude: myLocation.coords.longitude,
        latitudeDelta: 0.005,
        longitudeDelta: 0.005,
      },
      500
    );
  }, [myLocation]);

  if (!displayCoords) {
    return <Text style={{ color: 'white', textAlign: 'center' }}>위치 정보 없음</Text>;
  }

  const loadMorePlaces = async () => {
    if (!hasMoreResults || !destination.trim()) return;

    const nextPage = searchPage + 1;
    const newPlaces = await searchPlace(destination, nextPage);

    if (!newPlaces.length) {
      setHasMoreResults(false);
      return;
    }

    setSearchResults(prev => {
      const merged = [...prev, ...newPlaces];

      const unique = merged.filter(
        (item, index, self) =>
          index ===
          self.findIndex(
            x =>
              x.name === item.name &&
              x.latitude === item.latitude &&
              x.longitude === item.longitude
          )
      );

      return unique.sort((a: any, b: any) => a.distance - b.distance);
    });

    setSearchPage(nextPage);
  };

  const isAddressKeyword = (text: string) => {

    const keyword = text.replace(/\s/g, '');

    return (
      /\d/.test(keyword) ||
      keyword.includes('로') ||
      keyword.includes('길') ||
      keyword.includes('번길') ||
      keyword.includes('동') ||
      keyword.includes('가') ||
      keyword.includes('리') ||
      keyword.includes('읍') ||
      keyword.includes('면')
    );
  };
  const sortPlacesByRelevance = (places: any[], searchText: string) => {
  const searchKeyword = searchText.trim().replace(/\s/g, '');

  const getScore = (place: any) => {
    const name = (place.name || '').replace(/\s/g, '');
    const address = (place.fullAddress || '').replace(/\s/g, '');

    // 1. 이름이 검색어와 완전 일치
    if (name === searchKeyword) return 0;

    // 2. 이름이 검색어로 시작
    if (name.startsWith(searchKeyword)) return 1;

    // 3. 이름에 검색어 포함
    if (name.includes(searchKeyword)) return 2;

    // 4. 주소에 검색어 포함
    if (address.includes(searchKeyword)) return 3;

    // 5. 나머지
    return 10;
  };

  return places.sort((a, b) => {
    const scoreA = getScore(a);
    const scoreB = getScore(b);

    if (scoreA !== scoreB) {
      return scoreA - scoreB;
    }

    return a.distance - b.distance;
  });
};

const handleSearch = async () => {
  if (!destination.trim()) {
    Alert.alert('알림', '목적지를 입력하세요.');
    return;
  }

  Keyboard.dismiss();

  setRouteCoords([]);
  setGuidePoints([]);
  setCurrentGuideIndex(0);

  // ⭐ 1페이지만 말고 1~3페이지까지 먼저 가져오기
  const pages = await Promise.all([
    searchPlace(destination, 1),
    searchPlace(destination, 2),
    searchPlace(destination, 3),
  ]);

  const merged = pages.flat();

  const unique = merged.filter(
    (item, index, self) =>
      index ===
      self.findIndex(
        x =>
          x.name === item.name &&
          x.latitude === item.latitude &&
          x.longitude === item.longitude
      )
  );

  const sorted = sortPlacesByRelevance(unique, destination);

  const isStationSearch =
  destination.includes('역') ||
  destination.includes('전철') ||
  destination.includes('지하철');

let finalResults = sorted;

if (isStationSearch) {
  const stationResults = sorted.filter((p: any) => {
    const name = p.name || '';

    return (
      name.includes('역') ||
      name.includes('호선') ||
      name.includes('출구')
    );
  });

  const others = sorted.filter((p: any) => {
    const name = p.name || '';

    return !(
      name.includes('역') ||
      name.includes('호선') ||
      name.includes('출구')
    );
  });

  finalResults = [...stationResults, ...others];
}

  if (!sorted.length) {
    Alert.alert('검색 실패', '목적지를 찾을 수 없습니다.');
    return;
  }

setSearchResults(finalResults);  setSearchPage(3);
  setHasMoreResults(sorted.length >= 60);
};

const startRouteToPlace = async (place: any) => {
  Speech.stop();

  const route = await getRoute(
    displayCoords.latitude,
    displayCoords.longitude,
    place.latitude,
    place.longitude
  );

  if (!route?.features) {
    Alert.alert('경로 실패', '길찾기 결과가 없습니다.');
    return;
  }

  let totalDistance = 0;
  let totalTime = 0;

  route.features.forEach((f: any) => {
    if (f.properties?.distance) totalDistance += f.properties.distance;
    if (f.properties?.time) totalTime += f.properties.time;
  });

  const coords = route.features
    .filter((item: any) => item.geometry?.type === 'LineString')
    .flatMap((item: any) =>
      item.geometry.coordinates.map((coord: number[]) => ({
        latitude: coord[1],
        longitude: coord[0],
      }))
    );

  const points = route.features
    .filter(
      (item: any) =>
        item.geometry?.type === 'Point' &&
        item.properties?.description
    )
    .map((item: any) => ({
      latitude: item.geometry.coordinates[1],
      longitude: item.geometry.coordinates[0],
      description: item.properties.description,
    }));

  setRouteCoords(coords);
  setGuidePoints(points);
  setCurrentGuideIndex(0);

  setRecentPlaces(prev => {
    const updated = [
      place,
      ...prev.filter(
        p =>
          !(
            p.name === place.name &&
            p.latitude === place.latitude &&
            p.longitude === place.longitude
          )
      ),
    ];
    return updated.slice(0, 5);
  });

  const minutes = Math.round(totalTime / 60);
  const placeTitle = isAddressKeyword(destination)
    ? place.bldName || place.name || '목적지'
    : place.name;

  setIsSearchMode(false);
  setIsRecentHistoryMode(false);
  setIsRouteMapMode(true);

  Speech.speak(
    `${placeTitle}까지 ${formatDistance(totalDistance)}, 도보 ${minutes}분입니다. 길안내를 시작합니다.`,
    { language: 'ko-KR' }
  );

  if (coords.length > 0 && mapRef.current) {
    mapRef.current.fitToCoordinates(coords, {
      edgePadding: {
        top: 80,
        right: 50,
        bottom: 120,
        left: 50,
      },
      animated: true,
    });
  }
};

const triggerRecognitionWarning = async () => {
  const message = '테스트 경고입니다. 전방에 차량이 감지되었습니다.';

  Vibration.vibrate([0, 500, 200, 500]);
  Speech.stop();
  Speech.speak(message, { language: 'ko-KR' });

  await Notifications.scheduleNotificationAsync({
    content: {
      title: '위험 알림',
      body: message,
      sound: true,
    },
    trigger: null,
  });

  Alert.alert('위험 알림 테스트', message);
};

  return (
    <KeyboardAvoidingView
      style={styles.container}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >
      <TouchableWithoutFeedback onPress={Keyboard.dismiss}>
        <View style={styles.container}>
          {/* 검색 모드 */}
          {isSearchMode ? (
            <View style={{ flex: 1, paddingTop: 55 }}>
              <View
                style={{
                  flexDirection: 'row',
                  alignItems: 'center',
                  paddingHorizontal: 20,
                  marginBottom: 18,
                }}
              >
                <TouchableOpacity
                  onPress={() => {
                    setIsSearchMode(false);
                    setSearchResults([]);
                  }}
                  style={{ marginRight: 12 }}
                >
                  <Ionicons name="chevron-back" size={30} color="white" />
                </TouchableOpacity>

                <View
                  style={{
                    flex: 1,
                    height: 58,
                    backgroundColor: '#1A1A1A',
                    borderRadius: 30,
                    flexDirection: 'row',
                    alignItems: 'center',
                    paddingHorizontal: 18,
                  }}
                >
                  <Ionicons
                    name="search"
                    size={22}
                    color="#aaa"
                  />

                  <TextInput
                    style={{
                      flex: 1,
                      color: 'white',
                      fontSize: 22,
                      marginLeft: 12,
                    }}
                    placeholder="목적지 검색"
                    placeholderTextColor="#777"
                    value={destination}
                    onChangeText={setDestination}
                    autoFocus
                    returnKeyType="search"
                    onSubmitEditing={handleSearch}
                  />

                  {/* 🎤 음성 검색 */}
                  <TouchableOpacity
                    onPress={startVoiceRecognition}
                    style={{ marginRight: 10 }}
                  >
                    <Ionicons
                      name={isListening ? "mic" : "mic-outline"}
                      size={26}
                      color={isListening ? "#D2FF00" : "#aaa"}
                    />
                  </TouchableOpacity>

                  {/* ❌ 검색어 삭제 */}
                  <TouchableOpacity
                    onPress={() => {
                      setDestination('');
                      setSearchResults([]);
                    }}
                  >
                    <Ionicons
                      name="close-circle"
                      size={28}
                      color="#ddd"
                    />
                  </TouchableOpacity>
                </View>
              </View>
              {searchResults.length === 0 ? (
                <View style={{ flex: 1, paddingHorizontal: 20 }}>
                  <Text style={{ color: '#888', fontSize: 16, marginBottom: 14 }}>
                    검색어를 입력하면 결과가 아래에 표시됩니다.
                  </Text>

                  {favorites.length > 0 && (
                    <>
                      <Text
                        style={{
                          color: 'white',
                          fontSize: 18,
                          fontWeight: '700',
                          marginBottom: 10,
                        }}
                      >
                        ⭐ 즐겨찾기
                      </Text>

                      {favorites.slice(0, 5).map((place, index) => (
                        <TouchableOpacity
                          key={index}
                          onPress={() => startRouteToPlace(place)}
                          style={{
                            backgroundColor: '#111',
                            paddingVertical: 16,
                            paddingHorizontal: 16,
                            borderRadius: 14,
                            marginBottom: 10,
                          }}
                        >
                          <Text style={{ color: 'white', fontSize: 18, fontWeight: '700' }}>
                            {place.name}
                          </Text>
                          <Text style={{ color: '#aaa', marginTop: 4, fontSize: 14 }}>
                            {place.fullAddress || '주소 정보 없음'}
                          </Text>
                        </TouchableOpacity>
                      ))}
                    </>
                  )}
                </View>
              ) : (
                <FlatList
                  data={searchResults}
                  keyExtractor={(_, index) => index.toString()}
                  onEndReached={loadMorePlaces}
                  onEndReachedThreshold={0.5}
                  keyboardShouldPersistTaps="handled"
                  contentContainerStyle={{ paddingHorizontal: 20, paddingBottom: 30 }}
                  ListFooterComponent={
                    hasMoreResults ? (
                      <Text style={{ color: '#888', textAlign: 'center', paddingVertical: 12 }}>
                        더 불러오는 중...
                      </Text>
                    ) : null
                  }
                  renderItem={({ item: place, index }) => {
                    const isFavorite = favorites.some(
                      p =>
                        p.name === place.name &&
                        p.latitude === place.latitude &&
                        p.longitude === place.longitude
                    );

                    return (
                      <View
                        style={{
                          flexDirection: 'row',
                          alignItems: 'center',
                          paddingVertical: 18,
                          borderBottomWidth: 1,
                          borderBottomColor: '#222',
                        }}
                      >
                        {/* 왼쪽: 즐겨찾기 */}
                        <TouchableOpacity
                          onPress={() => {
                            if (isFavorite) {
                              setFavorites(prev =>
                                prev.filter(
                                  p =>
                                    !(
                                      p.name === place.name &&
                                      p.latitude === place.latitude &&
                                      p.longitude === place.longitude
                                    )
                                )
                              );
                              Speech.stop();
                              Speech.speak('즐겨찾기에서 제거되었습니다', { language: 'ko-KR' });
                            } else {
                              setFavorites(prev => [place, ...prev]);
                              Speech.stop();
                              Speech.speak('즐겨찾기에 추가되었습니다', { language: 'ko-KR' });
                            }
                          }}
                          style={{
                            width: 52,
                            height: 52,
                            borderRadius: 26,
                            backgroundColor: '#222',
                            justifyContent: 'center',
                            alignItems: 'center',
                            marginRight: 14,
                          }}
                        >
                          <Ionicons
                            name={isFavorite ? 'star' : 'star-outline'}
                            size={26}
                            color={isFavorite ? '#D2FF00' : '#bbb'}
                          />
                        </TouchableOpacity>

                        {/* 가운데: 누르면 음성 읽기 */}
                        <TouchableOpacity
                          style={{ flex: 1, paddingRight: 12 }}
                          onPress={() => {
                            Speech.stop();

                            const placeTitle = isAddressKeyword(destination)
                              ? place.bldName || place.name || '장소 정보'
                              : place.name;

                            Speech.speak(
                              `${index + 1}번, ${placeTitle}, ${formatDistance(place.distance)}`,
                              { language: 'ko-KR' }
                            );
                          }}
                        >
                          <Text style={{ color: 'white', fontSize: 20, fontWeight: '700' }}>
                            {isAddressKeyword(destination)
                              ? place.bldName || place.name || '장소 정보'
                              : place.name}
                          </Text>

                          <Text style={{ color: '#aaa', fontSize: 15, marginTop: 4 }}>
                            {place.fullAddress || '주소 정보 없음'}
                          </Text>

                          <Text style={{ color: '#888', fontSize: 14, marginTop: 4 }}>
                            {formatDistance(place.distance)}
                          </Text>
                        </TouchableOpacity>

                        {/* 오른쪽: 길찾기만 */}
                        <TouchableOpacity
                          style={{
                            backgroundColor: '#D2FF00',
                            borderRadius: 12,
                            paddingVertical: 12,
                            paddingHorizontal: 14,
                            justifyContent: 'center',
                            alignItems: 'center',
                          }}
                          onPress={async () => {
                            Speech.stop();

                            const route = await getRoute(
                              displayCoords.latitude,
                              displayCoords.longitude,
                              place.latitude,
                              place.longitude
                            );

                            if (!route?.features) {
                              Alert.alert('경로 실패', '길찾기 결과가 없습니다.');
                              return;
                            }

                            let totalDistance = 0;
                            let totalTime = 0;

                            route.features.forEach((f: any) => {
                              if (f.properties?.distance) totalDistance += f.properties.distance;
                              if (f.properties?.time) totalTime += f.properties.time;
                            });

                            const minutes = Math.round(totalTime / 60);

                            const coords = route.features
                              .filter((item: any) => item.geometry?.type === 'LineString')
                              .flatMap((item: any) =>
                                item.geometry.coordinates.map((coord: number[]) => ({
                                  latitude: coord[1],
                                  longitude: coord[0],
                                }))
                              );

                            setRouteCoords(coords);

                            const points = route.features
                              .filter(
                                (item: any) =>
                                  item.geometry?.type === 'Point' &&
                                  item.properties?.description
                              )
                              .map((item: any) => ({
                                latitude: item.geometry.coordinates[1],
                                longitude: item.geometry.coordinates[0],
                                description: item.properties.description,
                              }));

                            setGuidePoints(points);
                            setCurrentGuideIndex(0);

                            setRecentPlaces(prev => {
                              const updated = [
                                place,
                                ...prev.filter(
                                  p =>
                                    !(
                                      p.name === place.name &&
                                      p.latitude === place.latitude &&
                                      p.longitude === place.longitude
                                    )
                                ),
                              ];
                              return updated.slice(0, 5);
                            });

                            const placeTitle = isAddressKeyword(destination)
                              ? place.bldName || place.name || '목적지'
                              : place.name;

                            Speech.speak(
                              `${placeTitle}까지 ${formatDistance(totalDistance)}, 도보 ${minutes}분입니다. 길안내와 주변 인식을 시작합니다. `,
                              { language: 'ko-KR' }
                            );

                            setIsSearchMode(false);
                            setIsRouteMapMode(true);

                            Speech.stop();
                            Speech.speak(
                                '길안내와 주변 인식을 시작합니다.',
                              { language: 'ko-KR' }
                            );

                            if (coords.length > 0 && mapRef.current) {
                              mapRef.current.fitToCoordinates(coords, {
                                edgePadding: {
                                  top: 80,
                                  right: 50,
                                  bottom: 80,
                                  left: 50,
                                },
                                animated: true,
                              });
                            }
                          }}
                        >
                          <Text style={{ color: 'black', fontWeight: '800', fontSize: 14 }}>
                            길찾기
                          </Text>
                        </TouchableOpacity>
                      </View>
                    );
                  }}
                />
              )}
            </View>
          ) : isRouteMapMode ? (
            <View style={{ flex: 1, backgroundColor: '#000' }}>
         

              <TouchableWithoutFeedback
                onPress={() => {
                  if (guidePoints[currentGuideIndex]) {
                    Speech.stop();

                    Speech.speak(
`현재 방향은 ${
  typeof heading === 'number'
    ? ['북', '북동', '동', '남동', '남', '남서', '서', '북서'][
        Math.round(heading / 45) % 8
      ]
    : '방향 확인 중'
} 방향입니다. ${guidePoints[currentGuideIndex].description}`,                      {
                        language: 'ko-KR',
                      }
                    );

                    Vibration.vibrate(300);
                  }
                }}
              >
                <View style={{ flex: 1 }}>
                  <MapView
                    ref={mapRef}
                    style={{ flex: 1 }}
                    showsUserLocation={true}
                    initialRegion={{
                      latitude: displayCoords.latitude,
                      longitude: displayCoords.longitude,
                      latitudeDelta: 0.08,
                      longitudeDelta: 0.08,
                    }}
                  >
                    {routeCoords.length > 0 && (
                      <Polyline
                        coordinates={routeCoords}
                        strokeWidth={6}
                        strokeColor="#3B82F6"
                      />
                    )}
                  </MapView>
                </View>
              </TouchableWithoutFeedback>
              <View
                style={{
                  position: 'absolute',
                  top: 52,
                  left: 18,
                  right: 18,
                  backgroundColor: 'rgba(10,10,10,0.94)',
                  borderRadius: 22,
                  paddingVertical: 18,
                  paddingHorizontal: 18,
                  flexDirection: 'row',
                  alignItems: 'center',
                  borderWidth: 1,
                  borderColor: '#2A2A2A',
                }}
              >
                <Ionicons name="arrow-up" size={54} color="white" />
                <View style={{ flex: 1, marginLeft: 16 }}>
                  <Text style={{ color: 'white', fontSize: 34, fontWeight: '900' }}>
                    {guidePoints[currentGuideIndex] ? '150m' : '안내 중'}
                  </Text>
                  <Text style={{ color: '#ddd', fontSize: 17, fontWeight: '700', marginTop: 2 }}>
                    {guidePoints[currentGuideIndex]?.description || '목적지까지 경로가 표시됩니다'}
                  </Text>
                </View>
              </View>

              <View
                style={{
                  position: 'absolute',
                  right: 16,
                  top: 260,
                  gap: 12,
                }}
              >
                <TouchableOpacity
                  style={{
                    width: 48,
                    height: 48,
                    borderRadius: 24,
                    backgroundColor: '#050505',
                    justifyContent: 'center',
                    alignItems: 'center',
                  }}
                  onPress={() => {
                    Speech.stop();
                    Speech.speak(
                      guidePoints[currentGuideIndex]?.description || '길안내를 진행 중입니다',
                      { language: 'ko-KR' }
                    );
                  }}
                >
                  <Ionicons name="volume-high" size={24} color="white" />
                </TouchableOpacity>

                <TouchableOpacity
                  style={{
                    width: 48,
                    height: 48,
                    borderRadius: 24,
                    backgroundColor: '#050505',
                    justifyContent: 'center',
                    alignItems: 'center',
                  }}
                  onPress={() => setIsRecentHistoryMode(true)}
                >
                  <Ionicons name="list" size={24} color="white" />
                </TouchableOpacity>

                <TouchableOpacity
                  style={{
                    width: 48,
                    height: 48,
                    borderRadius: 24,
                    backgroundColor: '#050505',
                    justifyContent: 'center',
                    alignItems: 'center',
                  }}
                >
                  <Ionicons name="compass" size={24} color="#D2FF00" />
                </TouchableOpacity>
              </View>

              <TouchableOpacity
                style={{
                  position: 'absolute',
                  right: 20,
                  bottom: 124,
                  backgroundColor: '#A32626',
                  paddingVertical: 13,
                  paddingHorizontal: 24,
                  borderRadius: 18,
                  alignItems: 'center',
                }}
                onPress={() => setIsRouteMapMode(false)}
              >
                <Text style={{ color: 'white', fontSize: 18, fontWeight: '900' }}>
                  종료
                </Text>
              </TouchableOpacity>

              <TouchableOpacity
                onPress={() => {
                  const nextValue = !isRecognitionOn;
                  setIsRecognitionOn(nextValue);

                  if (nextValue) {
                    triggerRecognitionWarning();
                  } else {
                    Speech.stop();
                    Speech.speak('주변 인식을 껐습니다', { language: 'ko-KR' });
                  }
                }}
                style={{
                  position: 'absolute',
                  left: 16,
                  right: 16,
                  bottom: 24,
                  backgroundColor: isRecognitionOn ? 'rgba(10,14,0,0.94)' : 'rgba(15,15,15,0.94)',
                  borderRadius: 22,
                  padding: 18,
                  borderWidth: 1,
                  borderColor: isRecognitionOn ? '#D2FF00' : '#333',
                  flexDirection: 'row',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                }}
              >
                <View style={{ flexDirection: 'row', alignItems: 'center', flex: 1 }}>
                  <View
                    style={{
                      width: 52,
                      height: 52,
                      borderRadius: 26,
                      borderWidth: 2,
                      borderColor: isRecognitionOn ? '#D2FF00' : '#555',
                      justifyContent: 'center',
                      alignItems: 'center',
                      marginRight: 14,
                    }}
                  >
                    <Ionicons
                      name={isRecognitionOn ? 'radio-button-on' : 'radio-button-off'}
                      size={30}
                      color={isRecognitionOn ? '#D2FF00' : '#777'}
                    />
                  </View>
                  <View>
                    <Text style={{ color: 'white', fontSize: 19, fontWeight: '900' }}>
                      {isRecognitionOn ? '주변 인식 켜짐' : '주변 인식 꺼짐'}
                    </Text>
                    <Text style={{ color: '#aaa', fontSize: 13, marginTop: 4 }}>
                      {isRecognitionOn
                        ? '누르면 끄기, 다시 켜면 테스트 경고'
                        : '누르면 주변 인식 테스트 경고'}
                    </Text>
                  </View>
                </View>
                <View
                  style={{
                    width: 46,
                    height: 28,
                    borderRadius: 14,
                    backgroundColor: isRecognitionOn ? '#D2FF00' : '#444',
                    alignItems: isRecognitionOn ? 'flex-end' : 'flex-start',
                    justifyContent: 'center',
                    paddingHorizontal: 4,
                  }}
                >
                  <View style={{ width: 20, height: 20, borderRadius: 10, backgroundColor: 'white' }} />
                </View>
              </TouchableOpacity>

            </View>
              ) : isRecentHistoryMode ? (
              <View style={{ flex: 1, backgroundColor: '#000' }}>
                <View style={styles.header}>
                  <TouchableOpacity onPress={() => setIsRecentHistoryMode(false)}>
                    <Ionicons name="chevron-back" size={32} color={themeColor} />
                  </TouchableOpacity>
                  <Text style={styles.headerTitle}>최신 기록</Text>
                  <View style={{ width: 32 }} />
                </View>

                <View style={{ flex: 1, paddingHorizontal: 20, paddingTop: 10 }}>
                  {recentPlaces.length === 0 ? (
                    <View
                      style={{
                        backgroundColor: '#111',
                        borderRadius: 18,
                        padding: 18,
                      }}
                    >
                      <Text style={{ color: '#888', fontSize: 16 }}>
                        최근 기록이 없습니다.
                      </Text>
                    </View>
                  ) : (
                    <ScrollView showsVerticalScrollIndicator={false}>
                      {recentPlaces.map((place, index) => (
                        <View
                          key={index}
                          style={{
                            backgroundColor: '#111',
                            borderRadius: 18,
                            padding: 16,
                            marginBottom: 12,
                          }}
                        >
                          <TouchableOpacity
                            onPress={() => startRouteToPlace(place)}
                          >
                            <Text style={{ color: 'white', fontSize: 18, fontWeight: '700' }}>
                              {place.name}
                            </Text>
                            <Text style={{ color: '#aaa', fontSize: 14, marginTop: 4 }}>
                              {place.fullAddress || '주소 정보 없음'}
                            </Text>
                          </TouchableOpacity>

                          <View
                            style={{
                              flexDirection: 'row',
                              justifyContent: 'flex-end',
                              marginTop: 12,
                            }}
                          >
                            <TouchableOpacity
                              onPress={() => {
                                setRecentPlaces(prev =>
                                  prev.filter(
                                    p =>
                                      !(
                                        p.name === place.name &&
                                        p.latitude === place.latitude &&
                                        p.longitude === place.longitude
                                      )
                                  )
                                );
                                Speech.stop();
                                Speech.speak('최신 기록에서 삭제되었습니다', {
                                  language: 'ko-KR',
                                });
                              }}
                              style={{
                                backgroundColor: '#222',
                                paddingVertical: 10,
                                paddingHorizontal: 14,
                                borderRadius: 12,
                              }}
                            >
                              <Text style={{ color: 'white', fontWeight: '700' }}>삭제</Text>
                            </TouchableOpacity>
                          </View>
                        </View>
                      ))}
                    </ScrollView>
                  )}
                </View>
              </View>
              ) : (
              /* 기본 화면 */
              <View style={{ flex: 1, backgroundColor: '#000' }}>
                <MapView
                  ref={mapRef}
                  style={StyleSheet.absoluteFillObject}
                  showsUserLocation={true}
                  initialRegion={{
                    latitude: displayCoords.latitude,
                    longitude: displayCoords.longitude,
                    latitudeDelta: 0.006,
                    longitudeDelta: 0.006,
                  }}
                />

                <View
                  style={{
                    position: 'absolute',
                    top: 54,
                    left: 22,
                    right: 22,
                    flexDirection: 'row',
                    alignItems: 'center',
                    justifyContent: 'space-between',
                  }}
                >
                  <Text style={{ color: 'white', fontSize: 34, fontWeight: '900' }}>
                    See<Text style={{ color: '#D2FF00' }}>Q</Text>
                  </Text>

                  <View style={{ flexDirection: 'row', gap: 10 }}>
                    <TouchableOpacity
                      onPress={() => {
                        Speech.stop();
                        Speech.speak('현재 지도 화면입니다. 목적지를 입력해 주세요.', { language: 'ko-KR' });
                      }}
                      style={{
                        width: 48,
                        height: 48,
                        borderRadius: 24,
                        backgroundColor: '#111',
                        justifyContent: 'center',
                        alignItems: 'center',
                      }}
                    >
                      <Ionicons name="volume-high" size={24} color="white" />
                    </TouchableOpacity>

                    <TouchableOpacity
                      onPress={() => setCurrentScreen('home')}
                      style={{
                        width: 48,
                        height: 48,
                        borderRadius: 24,
                        backgroundColor: '#111',
                        justifyContent: 'center',
                        alignItems: 'center',
                      }}
                    >
                      <Ionicons name="menu" size={26} color="white" />
                    </TouchableOpacity>
                  </View>
                </View>

                <View
                  style={{
                    position: 'absolute',
                    left: 0,
                    right: 0,
                    bottom: 0,
                    paddingHorizontal: 20,
                    paddingBottom: 26,
                    paddingTop: 16,
                    backgroundColor: 'rgba(0,0,0,0.58)',
                  }}
                >
                  <TouchableOpacity
                    onPress={() => setIsSearchMode(true)}
                    style={{
                      backgroundColor: 'rgba(12,12,12,0.96)',
                      borderRadius: 28,
                      padding: 22,
                      borderWidth: 1,
                      borderColor: '#2A2A2A',
                      alignItems: 'center',
                    }}
                  >
                    <Text style={{ color: 'white', fontSize: 26, fontWeight: '900', marginBottom: 8 }}>
                      어디로 가시나요?
                    </Text>
                    <Text style={{ color: '#aaa', fontSize: 15, marginBottom: 18 }}>
                      말씀하시거나 검색해 주세요.
                    </Text>
                    <View
                      style={{
                        width: 78,
                        height: 78,
                        borderRadius: 39,
                        backgroundColor: '#D2FF00',
                        justifyContent: 'center',
                        alignItems: 'center',
                      }}
                    >
                      <Ionicons name="mic" size={38} color="black" />
                    </View>
                  </TouchableOpacity>

                  <View
                    style={{
                      flexDirection: 'row',
                      borderWidth: 1,
                      borderColor: '#333',
                      borderRadius: 18,
                      marginTop: 12,
                      overflow: 'hidden',
                    }}
                  >
                    <TouchableOpacity
                      onPress={() => setIsSearchMode(true)}
                      style={{ flex: 1, paddingVertical: 15, alignItems: 'center' }}
                    >
                      <Text style={{ color: '#D2FF00', fontWeight: '800' }}>즐겨찾기</Text>
                    </TouchableOpacity>
                    <View style={{ width: 1, backgroundColor: '#333' }} />
                    <TouchableOpacity
                      onPress={() => setIsRecentHistoryMode(true)}
                      style={{ flex: 1, paddingVertical: 15, alignItems: 'center' }}
                    >
                      <Text style={{ color: 'white', fontWeight: '800' }}>최근 목적지</Text>
                    </TouchableOpacity>
                  </View>

                  <View
                    style={{
                      flexDirection: 'row',
                      justifyContent: 'space-around',
                      alignItems: 'center',
                      paddingTop: 16,
                    }}
                  >
                    <TouchableOpacity style={{ alignItems: 'center' }}>
                      <Ionicons name="location" size={24} color="#D2FF00" />
                      <Text style={{ color: '#D2FF00', fontSize: 12, marginTop: 4, fontWeight: '800' }}>지도</Text>
                    </TouchableOpacity>
                    <TouchableOpacity onPress={() => setIsSearchMode(true)} style={{ alignItems: 'center' }}>
                      <Ionicons name="navigate" size={24} color="white" />
                      <Text style={{ color: 'white', fontSize: 12, marginTop: 4, fontWeight: '800' }}>길찾기</Text>
                    </TouchableOpacity>
                    <TouchableOpacity onPress={() => setCurrentScreen('home')} style={{ alignItems: 'center' }}>
                      <Ionicons name="ellipsis-horizontal" size={26} color="white" />
                      <Text style={{ color: 'white', fontSize: 12, marginTop: 4, fontWeight: '800' }}>더보기</Text>
                    </TouchableOpacity>
                  </View>
                </View>
              </View>
                  )}
        </View>
      </TouchableWithoutFeedback>
    </KeyboardAvoidingView>
  );
}
// ============================================================
// 4. 메인 앱: 전체 상태, 권한, 위치 추적, 화면 전환
// ============================================================
export default function SeeQFinalApp() {
  const [heading, setHeading] = useState(0);
  const [googleRequest, googleResponse, promptGoogleLogin] =
    Google.useIdTokenAuthRequest({
      webClientId: GOOGLE_WEB_CLIENT_ID,
      iosClientId: GOOGLE_IOS_CLIENT_ID,
      androidClientId: GOOGLE_ANDROID_CLIENT_ID,
      selectAccount: true,
    });

  // 🔥 알림 권한 요청
  useEffect(() => {
    const requestNotificationPermission = async () => {
      await Notifications.requestPermissionsAsync();
    };

    requestNotificationPermission();
  }, []);

  useEffect(() => {
    // 나침반 센서 값을 실시간으로 heading 변수에 저장합니다.
    const subscribe = Magnetometer.addListener(data => {
      let angle = Math.atan2(data.y, data.x) * (180 / Math.PI);

      if (angle < 0) angle += 360;

      setHeading(angle);
    });

    return () => subscribe.remove();
  }, []);
const [currentScreen, setCurrentScreen] = useState('login');
const [userType, setUserType] = useState('user');
const [currentUser, setCurrentUser] = useState<any>(auth.currentUser);
const [myLocation, setMyLocation] = useState<any>(null);
const [targetLocation, setTargetLocation] = useState<any>(null);
const [emergencyStatus, setEmergencyStatus] = useState(false);
const [shareLocation, setShareLocation] = useState(false);
const [canGuardianViewLocation, setCanGuardianViewLocation] = useState(false);
const [isUpdatingShare, setIsUpdatingShare] = useState(false);
const [moveLogs, setMoveLogs] = useState<string[]>(["시스템 연결 대기 중..."]);
const [userAddress, setUserAddress] = useState('');
const [guardianAddress, setGuardianAddress] = useState('');
const [routeCoords, setRouteCoords] = useState<any[]>([]);
const [destination, setDestination] = useState('');
const [guidePoints, setGuidePoints] = useState<any[]>([]);
const [currentGuideIndex, setCurrentGuideIndex] = useState(0);
const [lastSpokenGuide, setLastSpokenGuide] = useState('');
const [lastSpokenIndex, setLastSpokenIndex] = useState(-1);
const [spokenStages, setSpokenStages] = useState<Record<number, number>>({});
const [searchResults, setSearchResults] = useState<any[]>([]);
const [searchPage, setSearchPage] = useState(1);
const [hasMoreResults, setHasMoreResults] = useState(true);
const [recentPlaces, setRecentPlaces] = useState<any[]>([]);
const [favorites, setFavorites] = useState<any[]>([]);
const [guardianTargets, setGuardianTargets] = useState<any[]>([]);
const [moveStatus, setMoveStatus] = useState('정지 중');
const [lastUpdateTime, setLastUpdateTime] = useState('');
const [isListening, setIsListening] = useState(false);
const [recognizedText, setRecognizedText] = useState('');

const [authMode, setAuthMode] = useState<'login' | 'signup'>('login');
const [needsProfileSetup, setNeedsProfileSetup] = useState(false);
const [name, setName] = useState('');
const [email, setEmail] = useState('');
const [password, setPassword] = useState('');
const [pairCodeInput, setPairCodeInput] = useState('');

const nameRef = useRef('');

const generatePairCode = () => {
  return Math.random().toString(36).substring(2, 8).toUpperCase();
};

const getAuthErrorMessage = (error: any) => {
  switch (error?.code) {
    case 'auth/email-already-in-use':
      return '이미 가입된 이메일입니다. 로그인 화면에서 이메일 로그인을 이용해 주세요.';
    case 'auth/invalid-email':
      return '이메일 형식이 올바르지 않습니다.';
    case 'auth/weak-password':
      return '비밀번호는 6자리 이상으로 입력해 주세요.';
    case 'auth/user-not-found':
    case 'auth/invalid-credential':
    case 'auth/wrong-password':
      return '이메일 또는 비밀번호를 확인해 주세요.';
    case 'auth/network-request-failed':
      return '네트워크 연결을 확인한 뒤 다시 시도해 주세요.';
    default:
      return error?.message || '문제가 발생했습니다. 잠시 후 다시 시도해 주세요.';
  }
};

  const isGoogleLoginReady =
    !GOOGLE_WEB_CLIENT_ID.startsWith('YOUR_') &&
    !GOOGLE_IOS_CLIENT_ID.startsWith('YOUR_') &&
    !GOOGLE_ANDROID_CLIENT_ID.startsWith('YOUR_');

  const handleGoogleLogin = async () => {
    if (!isGoogleLoginReady) {
      Alert.alert(
        'Google 로그인 설정 필요',
        'Firebase/Google Cloud에서 발급한 Web, iOS, Android Client ID를 코드 상단의 GOOGLE_*_CLIENT_ID에 넣어주세요.'
      );
      return;
    }

    try {
      await promptGoogleLogin();
    } catch (error: any) {
      console.log('Google 로그인 실패', error);
      Alert.alert(
        'Google 로그인 실패',
        error?.message || 'Google 로그인 중 문제가 발생했습니다.'
      );
    }
  };
const handleAppleLogin = async () => {
  try {
    const credential = await AppleAuthentication.signInAsync({
      requestedScopes: [
        AppleAuthentication.AppleAuthenticationScope.FULL_NAME,
        AppleAuthentication.AppleAuthenticationScope.EMAIL,
      ],
    });

    const provider = new OAuthProvider('apple.com');

    const firebaseCredential = provider.credential({
      idToken: credential.identityToken!,
    });

    const result = await signInWithCredential(auth, firebaseCredential);

    const userRef = ref(db, `users/${result.user.uid}`);
    const snapshot = await get(userRef);

    if (!snapshot.exists()) {
      setCurrentUser(result.user);
      setNeedsProfileSetup(true);
      return;
    }

    setCurrentUser(result.user);
    setCurrentScreen('home');

  } catch (e: any) {
    Alert.alert('Apple 로그인 실패', e.message);
  }
};

const completeProfileSetup = async () => {
  if (!currentUser) return;

  if (!name.trim()) {
  Alert.alert('입력 필요', '이름을 입력하세요.');
  return;
}

  try {
    const userRef = ref(db, `users/${currentUser.uid}`);

    let pairCode = null;

    if (userType === 'user') {
      pairCode = Math.random()
        .toString(36)
        .substring(2, 8)
        .toUpperCase();
    }

    await set(userRef, {
      name,
      email: currentUser.email || email,
      role: userType,
      provider: currentUser.providerData?.[0]?.providerId || 'email',
      pairCode,
      pairedGuardian: null,
      pairedUser: null,
      shareLocation: false,
      emergency: false,
    });

    setNeedsProfileSetup(false);
    Alert.alert('회원가입 완료', '회원가입이 완료되었습니다.', [
      { text: '확인', onPress: () => setCurrentScreen('home') },
    ]);

  } catch (error: any) {
    Alert.alert('저장 실패', error.message);
  }
};

const handleEmailLogin = async () => {
  if (!email.trim() || !password.trim()) {
    Alert.alert('입력 필요', '이메일과 비밀번호를 입력해 주세요.');
    return;
  }

  try {
    const result = await signInWithEmailAndPassword(
      auth,
      email.trim(),
      password
    );

    await result.user.reload();

    const snapshot = await get(ref(db, `users/${result.user.uid}`));

    if (!snapshot.exists()) {
      setCurrentUser(result.user);
      setNeedsProfileSetup(true);
      return;
    }

    setCurrentUser(result.user);
    setCurrentScreen('home');

  } catch (error: any) {
    Alert.alert('로그인 실패', getAuthErrorMessage(error));
  }
};

const handleEmailSignup = async () => {
  if (!email.trim() || !password.trim()) {
    Alert.alert('입력 필요', '이메일과 비밀번호를 입력해 주세요.');
    return;
  }

  if (password.length < 6) {
    Alert.alert('비밀번호 확인', '6자리 이상 입력하세요.');
    return;
  }

  try {
    const result = await createUserWithEmailAndPassword(
      auth,
      email.trim(),
      password
    );

    setCurrentUser(result.user);
    setNeedsProfileSetup(true);

    Alert.alert(
      '회원가입 완료',
      '회원가입이 완료되었습니다. 이어서 프로필 정보를 입력해 주세요.'
    );

  } catch (error: any) {
    if (error?.code === 'auth/email-already-in-use') {
      Alert.alert(
        '이미 가입된 이메일',
        '이 이메일은 이미 가입되어 있습니다. 로그인 화면으로 이동할까요?',
        [
          { text: '취소', style: 'cancel' },
          {
            text: '로그인하기',
            onPress: () => {
              setAuthMode('login');
              setCurrentScreen('login');
            },
          },
        ]
      );
      return;
    }

    Alert.alert('회원가입 실패', getAuthErrorMessage(error));
  }
};
  const handleLogout = async () => {
    try {
      await signOut(auth);
      setFavorites([]);
      setRecentPlaces([]);
setCurrentScreen('login');
      Speech.stop();
      Speech.speak('로그아웃되었습니다', { language: 'ko-KR' });
    } catch (error: any) {
      console.log('로그아웃 실패', error);
      Alert.alert('로그아웃 실패', error?.message || '로그아웃 중 문제가 발생했습니다.');
    }
  };

  const requireLogin = (nextScreen: string) => {
    if (!currentUser) {
      Alert.alert('로그인 필요', '로그인 후 이용할 수 있습니다.');
      setCurrentScreen('login');
      return;
    }

    setCurrentScreen(nextScreen);
  };

  const addGuardianTarget = () => {
    if (!currentUser) {
      requireLogin('home');
      return;
    }

    Alert.prompt(
      '관리 대상 추가',
      '위치를 확인할 가족의 이름을 입력하세요.',
      [
        { text: '취소', style: 'cancel' },
        {
          text: '추가',
          onPress: (name?: string) => {
            const targetName = name?.trim();

            if (!targetName) {
              Alert.alert('입력 필요', '이름을 입력해 주세요.');
              return;
            }

            setGuardianTargets(prev => [
              {
                id: `${Date.now()}`,
                name: targetName,
                status: '안전',
                lastSeen: '아직 위치 확인 전',
              },
              ...prev,
            ]);
          },
        },
      ],
      'plain-text'
    );
  };

useEffect(() => {
